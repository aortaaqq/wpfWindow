<Window x:Class="wpfWindow.windows.AddBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpfWindow.windows"
        mc:Ignorable="d"
        Title="AddBookWindow" Height="450" Width="800">
    <StackPanel>
        <TextBlock Text="Название" Margin="5"/>
        <TextBox Text="{Binding Title}" Margin="5"/>

        <TextBlock Text="Автор" Margin="5"/>
        <TextBox Text="{Binding Author}" Margin="5"/>

        <TextBlock Text="Год издания" Margin="5"/>
        <TextBox Text="{Binding Year}" Margin="5"/>

        <Button Content="Добавить" Click="Add_Click" Margin="5"/>
        <Button Content="Отмена" Click="Cancel_Click" Margin="5"/>
    </StackPanel>
</Window>
